# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — only for bulk user scripts (scripts/create-auth-users.mjs)
# Supabase Dashboard → Settings → API → service_role (keep secret, never commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Windows office server photo sync (scripts/windows-photo-sync.mjs)
# PHOTOS_ROOT=D:\MalconNexus\Photos
# PHOTOS_SYNC_MAX_DOWNLOADS_PER_RUN=20
# PHOTOS_SYNC_MAX_CASES=100
# PHOTOS_SYNC_LOOKBACK_DAYS=90
# PHOTOS_CLEANUP_RETENTION_DAYS=30
# PHOTOS_CLEANUP_MAX_DELETIONS_PER_RUN=50

# WhatsApp attendance + good-morning post (scripts/daily-attendance-whatsapp.mjs)
# ATTENDANCE_WHATSAPP_GROUP_NAME=Your Exact WhatsApp Group Name
# ATTENDANCE_WHATSAPP_GROUP_ID=120363012345678901@g.us
# ATTENDANCE_WHATSAPP_SESSION_PATH=D:\MalconNexus\WhatsAppSession
# ATTENDANCE_REPORTS_DIR=D:\MalconNexus\AttendanceReports
# ATTENDANCE_WHATSAPP_GOOD_MORNING_TEXT=Good morning! Malcon Nexus is ready.
# ATTENDANCE_WHATSAPP_MORNING_IMAGE=D:\malcon-nexus\GM.png   (optional — defaults to GM.png in repo root)
# Schedule good-morning group (9 AM): scripts/setup-good-morning-group-task.ps1
# ATTENDANCE_WHATSAPP_DM_PHONE=919876543210   (optional — for --good-morning-dm test only)
# Schedule good-morning DM: scripts/setup-good-morning-dm-task.ps1

# Email (Resend) — set in Supabase Edge Function secrets, NOT in .env or Vercel
# Dashboard → Project Settings → Edge Functions → Secrets:
#   RESEND_API_KEY=re_xxxx
#   RESEND_FROM_EMAIL=noreply@malconnexus.com
#   APP_URL=https://malconnexus.com
# Deploy: supabase functions deploy send-assignment-email
#          supabase functions deploy update-employee-login-email
