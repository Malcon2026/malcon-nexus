# Supabase — authentication only in production (data on Convex)
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Convex (local dev — also written by `npx convex dev`)
# VITE_USE_CONVEX_BACKEND=true
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# CONVEX_MIGRATION_KEY=choose-a-long-random-string
# Production Hostinger: copy .env.production.convex.example → .env.production.convex

# Phase 8 — local Worker read migration (default: Supabase reads)
# VITE_USE_WORKER_READS=false
# Phase 9.1 — notification reads only (default: Supabase)
# VITE_USE_WORKER_NOTIFICATION_READS=false
# Phase 9.2 — reference data reads (hospitals, doctors, departments, kits, settings)
# VITE_USE_WORKER_REFERENCE_READS=false
# Phase 9.3 — attendance, leave, petrol, food, trips, expenses (reads only; default off)
# VITE_USE_WORKER_OPERATIONS_READS=false
# Phase 9.4 — approvals, activity, case-task reads + case scope filtering (default off)
# VITE_USE_WORKER_REMAINING_READS=false
# VITE_WORKER_API_URL=http://127.0.0.1:8787
#
# Emergency data cutover (Supabase Auth only): see .env.production.cutover.example
#   npm run deploy:hostinger:cutover

# Optional — only for bulk user scripts (scripts/create-auth-users.mjs)
# Supabase Dashboard → Settings → API → service_role (keep secret, never commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Windows office server photo sync (scripts/windows-photo-sync.mjs)
# PHOTOS_ROOT=D:\MalconNexus\Photos
# PHOTOS_SYNC_MAX_DOWNLOADS_PER_RUN=20
# PHOTOS_SYNC_MAX_CASES=100
# PHOTOS_SYNC_LOOKBACK_DAYS=90
# PHOTOS_CLEANUP_RETENTION_DAYS=30
# PHOTOS_CLEANUP_MAX_DELETIONS_PER_RUN=50

# WhatsApp attendance + good-morning post (scripts/daily-attendance-whatsapp.mjs)
# ATTENDANCE_WHATSAPP_GROUP_NAME=Your Exact WhatsApp Group Name
# ATTENDANCE_WHATSAPP_GROUP_ID=120363012345678901@g.us
# ATTENDANCE_WHATSAPP_SESSION_PATH=D:\MalconNexus\WhatsAppSession
# ATTENDANCE_REPORTS_DIR=D:\MalconNexus\AttendanceReports
# ATTENDANCE_WHATSAPP_GOOD_MORNING_TEXT=Good morning! Malcon Nexus is ready.
# ATTENDANCE_WHATSAPP_MORNING_IMAGE=D:\malcon-nexus\GM.png   (optional — defaults to GM.png in repo root)
# Schedule good-morning group (9 AM): scripts/setup-good-morning-group-task.ps1
# ATTENDANCE_WHATSAPP_DM_PHONE=919876543210   (optional — for --good-morning-dm test only)
# Schedule good-morning DM: scripts/setup-good-morning-dm-task.ps1

# Email (Resend) — set in Supabase Edge Function secrets, NOT in .env or Vercel
# Dashboard → Project Settings → Edge Functions → Secrets:
#   RESEND_API_KEY=re_xxxx
#   RESEND_FROM_EMAIL=noreply@malconnexus.com
#   APP_URL=https://malconnexus.com
# Deploy: supabase functions deploy send-assignment-email
#          supabase functions deploy update-employee-login-email

# Web Push (PWA phone notifications) — public key in Vercel + .env; private key in Supabase only
# Generate: node scripts/setup-push.mjs
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Supabase Edge Function secrets: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# Deploy: supabase functions deploy push-subscribe && supabase functions deploy send-push
