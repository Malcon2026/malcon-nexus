# Hostinger production — AWS PostgreSQL + S3 API (no Supabase)
VITE_USE_AWS_BACKEND=true
VITE_USE_CLOUDFLARE_BACKEND=false
VITE_WORKER_API_URL=https://YOUR_AWS_API_URL
# VITE_API_BASE_URL=https://YOUR_AWS_API_URL
# Required for admin “Force advance” on case detail (not committed — set in .env.production.aws)
# VITE_FORCE_ADVANCE_PASSWORD=your-override-password
