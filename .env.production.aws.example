# Hostinger production — AWS PostgreSQL + S3 API (no Supabase)
# Copy to .env.production.aws (gitignored) before npm run deploy:hostinger:aws
#
# Do NOT set VITE_SUPABASE_URL or VITE_SUPABASE_ANON_KEY — deploy strips them anyway.
VITE_USE_AWS_BACKEND=true
VITE_USE_CLOUDFLARE_BACKEND=false
VITE_WORKER_API_URL=https://njbtfquxeh.execute-api.ap-south-1.amazonaws.com
# VITE_API_BASE_URL=https://njbtfquxeh.execute-api.ap-south-1.amazonaws.com

# Do NOT set VITE_FORCE_ADVANCE_PASSWORD for AWS production (secret would ship in the SPA bundle).
# Force advance on AWS uses authenticated admin role only; any non-empty confirmation in the UI is enough.

# Gallery / TV kiosk token URLs read photos from PostgreSQL + S3 (set in malcon-nexus/api-env secret, not in SPA):
# GALLERY_TOKEN=...
# TV_BOARD_TOKEN=...

# Optional (non-secret): attendance selfie-only mode, super-admin allowlist
# VITE_ATTENDANCE_SELFIE_ONLY=true
# VITE_SUPER_ADMIN_EMAILS=admin@example.com
