# AWS-only production (RDS + S3 API). Copy to `.env.production.aws` (gitignored).
# Deploy SPA: npm run deploy:hostinger:aws
# Deploy API: cd aws-api && npm run deploy:apprunner  (requires AWS CLI + ECR)

VITE_USE_AWS_BACKEND=true
VITE_USE_CLOUDFLARE_BACKEND=false

# Set after App Runner / ECS deploy (no trailing slash):
VITE_API_BASE_URL=https://YOUR_APP_RUNNER_SERVICE_URL
# Alias also supported:
# VITE_WORKER_API_URL=https://YOUR_APP_RUNNER_SERVICE_URL

# Do not set VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in AWS production builds.

# Optional — web push still needs VAPID public key if enabled later
# VITE_VAPID_PUBLIC_KEY=
