# Cloudflare-only production (no Supabase). Copy to `.env.production.cloudflare` (gitignored).
# Deploy: npm run deploy:hostinger:cloudflare
#
# BEFORE first admin login: set password on production D1 (see scripts/worker-set-password.mjs).

VITE_USE_CLOUDFLARE_BACKEND=true
VITE_WORKER_API_URL=https://malcon-nexus-api.malcon-nexus.workers.dev

# Telegram OTP + broadcasts (Worker secrets, not Vite):
#   cp .env.telegram.local.example .env.telegram.local  # add bot token from @BotFather
#   npm run telegram:configure
#   npm run telegram:sync-ids   # optional re-sync chat IDs from Supabase → D1

# Optional — web push still needs VAPID public key in the SPA
# VITE_VAPID_PUBLIC_KEY=
