# Copy to `.env.production.convex` (gitignored). Hostinger production:
#   npm run deploy:hostinger
#
# Data: Convex (malcon-backend team). Auth: Supabase only (no Supabase Postgres reads).

VITE_USE_CONVEX_BACKEND=true
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Remote reads/writes use Convex HTTP routes (Worker-compatible paths)
VITE_USE_WORKER_READS=true
VITE_USE_WORKER_NOTIFICATION_READS=true
VITE_USE_WORKER_REFERENCE_READS=true
VITE_USE_WORKER_OPERATIONS_READS=true
VITE_USE_WORKER_REMAINING_READS=true
VITE_USE_WORKER_WRITES_ACTIVITY=true
VITE_USE_WORKER_WRITES_NOTIFICATIONS=true
VITE_USE_WORKER_WRITES_SETTINGS=true
VITE_USE_WORKER_WRITES_KITS=true
VITE_USE_WORKER_WRITES_EXPENSES=true
VITE_USE_WORKER_WRITES_APPROVALS=true
VITE_USE_WORKER_WRITES_EMPLOYEES=true
VITE_USE_WORKER_WRITES_HOSPITALS=true
VITE_USE_WORKER_WRITES_DOCTORS=true
VITE_USE_WORKER_WRITES_ATTENDANCE=true
VITE_USE_WORKER_WRITES_LEAVE=true
VITE_USE_WORKER_WRITES_FOOD=true
VITE_USE_WORKER_WRITES_PETROL=true
VITE_USE_WORKER_WRITES_TRIPS=true
VITE_USE_WORKER_WRITES_CASE_TASKS=true
VITE_USE_WORKER_WRITES_CASES=true
VITE_USE_WORKER_WRITES_CASE_CLAIM=true

# Optional — gallery static bundle API base (defaults to VITE_CONVEX_SITE_URL in deploy script)
# VITE_WORKER_API_URL=https://your-deployment.convex.site

# Set on Convex deployment (Dashboard → Settings → Environment Variables):
#   SUPABASE_JWT_SECRET=<Supabase Settings → API → JWT Secret>
#   API_CORS_ORIGIN=https://app.malconnexus.com
#   SUPABASE_JWT_AUD=authenticated
