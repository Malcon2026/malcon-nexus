# Copy to `.env.production.cutover` (gitignored). Use with:
#   npm run deploy:hostinger:cutover
#
# Login stays on Supabase Auth. App data (reads/writes) uses Cloudflare Worker + D1.
# Fix Supabase billing / egress restriction first — auth API must respond before anyone can sign in.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_WORKER_API_URL=https://malcon-nexus-api.malcon-nexus.workers.dev

# Reads
VITE_USE_WORKER_READS=true
VITE_USE_WORKER_NOTIFICATION_READS=true
VITE_USE_WORKER_REFERENCE_READS=true
VITE_USE_WORKER_OPERATIONS_READS=true
VITE_USE_WORKER_REMAINING_READS=true

# Writes (Phase 10)
VITE_USE_WORKER_WRITES_ACTIVITY=true
VITE_USE_WORKER_WRITES_NOTIFICATIONS=true
VITE_USE_WORKER_WRITES_SETTINGS=true
VITE_USE_WORKER_WRITES_KITS=true
VITE_USE_WORKER_WRITES_EXPENSES=true
VITE_USE_WORKER_WRITES_APPROVALS=true
VITE_USE_WORKER_WRITES_EMPLOYEES=true
VITE_USE_WORKER_WRITES_HOSPITALS=true
VITE_USE_WORKER_WRITES_DOCTORS=true
VITE_USE_WORKER_WRITES_ATTENDANCE=true
VITE_USE_WORKER_WRITES_LEAVE=true
VITE_USE_WORKER_WRITES_FOOD=true
VITE_USE_WORKER_WRITES_PETROL=true
VITE_USE_WORKER_WRITES_TRIPS=true
VITE_USE_WORKER_WRITES_CASE_TASKS=true
VITE_USE_WORKER_WRITES_CASES=true
VITE_USE_WORKER_WRITES_CASE_CLAIM=true

# Storage still Supabase until R2 is bound — leave off to avoid broken uploads
# VITE_USE_WORKER_STORAGE=false
