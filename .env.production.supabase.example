# Malcon Nexus — Supabase-only production (database + auth).
# Copy to `.env.production.supabase` (gitignored), fill in the anon key, then:
#   npm run deploy:hostinger:supabase

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Supabase-only: every other backend must stay off.
VITE_USE_CONVEX_BACKEND=false
VITE_USE_CLOUDFLARE_BACKEND=false
VITE_USE_AWS_BACKEND=false

VITE_USE_WORKER_READS=false
VITE_USE_WORKER_NOTIFICATION_READS=false
VITE_USE_WORKER_REFERENCE_READS=false
VITE_USE_WORKER_OPERATIONS_READS=false
VITE_USE_WORKER_REMAINING_READS=false

# Gallery / TV bundles call Supabase Edge Functions.
VITE_WORKER_API_URL=https://your-project-ref.supabase.co/functions/v1
