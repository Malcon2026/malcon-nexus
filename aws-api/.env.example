# Local / App Runner runtime — never commit real values.
# Prefer AWS Secrets Manager: set MALCON_API_SECRET_ARN to JSON with keys below.

PORT=8080
ENVIRONMENT=production
API_CORS_ORIGIN=https://app.malconnexus.com
API_REQUIRE_AUTH=1

# RDS PostgreSQL (database malconnexus)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/malconnexus

# Must match Cloudflare Worker production JWT signing secret
JWT_SECRET=
# alias accepted:
# SUPABASE_JWT_SECRET=

LOGIN_OTP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

AWS_REGION=ap-south-1
S3_BUCKET_STAGE_PHOTOS=
S3_BUCKET_ATTENDANCE_SELFIES=
S3_BUCKET_HR_KYC_UPLOADS=
S3_PUBLIC_BASE_URL=

# Optional: single JSON secret in Secrets Manager
# MALCON_API_SECRET_ARN=arn:aws:secretsmanager:...
