{
  "name": "malcon-nexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.gallery.config.ts && vite build --config vite.tv.config.ts",
    "preview": "vite preview",
    "db:health": "node scripts/db-health-check.mjs",
    "db:doctor-code": "node scripts/apply-doctor-code-via-api.mjs 2>/dev/null || node scripts/apply-doctor-code-migration.mjs; node scripts/sync-doctors-master.mjs --execute",
    "db:doctor-code:sync": "node scripts/sync-doctors-master.mjs --execute",
    "photos:sync": "node scripts/windows-photo-sync.mjs",
    "photos:migrate": "node scripts/migrate-office-photos-layout.mjs",
    "photos:migrate:execute": "node scripts/migrate-office-photos-layout.mjs --execute",
    "photos:purge": "node scripts/purge-old-photos.mjs",
    "attendance:whatsapp": "node scripts/daily-attendance-whatsapp.mjs",
    "attendance:whatsapp:install": "npm install --prefix scripts",
    "attendance:whatsapp:png": "node scripts/daily-attendance-whatsapp.mjs --png-only",
    "attendance:whatsapp:groups": "node scripts/daily-attendance-whatsapp.mjs --list-groups",
    "attendance:whatsapp:noon": "node scripts/daily-attendance-whatsapp.mjs --filters=in,absent,unclosed",
    "attendance:whatsapp:boss-test": "node scripts/daily-attendance-whatsapp.mjs --boss-test",
    "attendance:whatsapp:boss-report": "node scripts/daily-attendance-whatsapp.mjs --boss-only --filters=in,absent",
    "selfies:archive": "node scripts/archive-punch-in-selfies.mjs",
    "gallery:setup": "node scripts/setup-gallery.mjs",
    "tv:setup": "node scripts/setup-tv.mjs",
    "gallery:publish": "node scripts/publish-gallery-site.mjs",
    "deploy:hostinger": "node scripts/deploy-hostinger-app.mjs --convex",
    "deploy:hostinger:convex": "node scripts/deploy-hostinger-app.mjs --convex",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "migrate:convex": "node scripts/migrate-to-convex.mjs --apply",
    "migrate:convex:dry-run": "node scripts/migrate-to-convex.mjs --dry-run",
    "deploy:hostinger:cutover": "node scripts/deploy-hostinger-app.mjs --cutover",
    "deploy:hostinger:cloudflare": "node scripts/deploy-hostinger-app.mjs --cloudflare",
    "deploy:hostinger:aws": "node scripts/deploy-hostinger-app.mjs --aws",
    "aws:export-d1": "cd worker && npx wrangler d1 export malcon-nexus-production --remote --env production --output ../backups/d1-production-export.sql",
    "aws:migrate-data": "node scripts/aws/migrate-d1-to-postgres.mjs --apply-schema --import-data",
    "aws:migrate:verify": "node scripts/aws/import-jsonl-to-postgres.mjs --dir backups/d1-production-jsonl --verify",
    "aws:schema": "node scripts/aws/apply-postgres-schema.mjs",
    "aws:provision": "node scripts/aws/provision-aws.mjs --execute",
    "telegram:sync-ids": "node scripts/sync-telegram-chat-ids-to-d1.mjs",
    "telegram:link": "node scripts/link-telegram-chat-id-d1.mjs",
    "telegram:configure": "node scripts/configure-worker-telegram.mjs",
    "auth:migrate-supabase-to-d1": "node scripts/migrate-supabase-auth-to-d1.mjs",
    "phase11:verify-export": "node scripts/phase11-verify-export.mjs",
    "phase11:bakeoff": "node scripts/phase11-staging-bakeoff.mjs",
    "build:vercel-legacy": "node scripts/build-vercel-legacy.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "test:security": "node scripts/test-security-authz.mjs",
    "test:ecs-task-def": "node scripts/aws/ecs-task-definition.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "convex": "^1.47.0",
    "pg": "^8.23.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
