{
    "RoleName": "malconEcsTaskRole",
    "PolicyName": "malconNexusTaskS3Secrets",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "StagePhotosObjects",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": "arn:aws:s3:::malcon-nexus-stage-photos-*/*"
            },
            {
                "Sid": "AttendanceSelfiesObjects",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": "arn:aws:s3:::malcon-nexus-attendance-selfies-*/*"
            },
            {
                "Sid": "HrKycObjects",
                "Effect": "Allow",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Resource": "arn:aws:s3:::malcon-nexus-hr-kyc-*/*"
            },
            {
                "Sid": "ListBucketsForHealth",
                "Effect": "Allow",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation"
                ],
                "Resource": [
                    "arn:aws:s3:::malcon-nexus-stage-photos-*",
                    "arn:aws:s3:::malcon-nexus-attendance-selfies-*",
                    "arn:aws:s3:::malcon-nexus-hr-kyc-*"
                ]
            }
        ]
    }
}
