{
  "name": "malcon-nexus-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply malcon-nexus-dev --local",
    "db:migrate:staging": "wrangler d1 migrations apply malcon-nexus-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply malcon-nexus-production --remote --env production",
    "db:create:staging": "wrangler d1 create malcon-nexus-staging",
    "db:create:production": "wrangler d1 create malcon-nexus-production",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:seed": "node scripts/seed-local.mjs",
    "db:validate": "node scripts/validate-local-d1.mjs",
    "db:test": "node scripts/test-local-d1.mjs",
    "test:api": "node scripts/test-api-local.mjs",
    "test:writes": "node ../scripts/test-low-risk-writes.mjs",
    "test:writes:medium": "node ../scripts/test-medium-risk-writes.mjs",
    "test:writes:cases": "node ../scripts/test-case-writes.mjs",
    "test:auth": "node ../scripts/test-worker-auth.mjs",
    "test:storage": "node ../scripts/test-worker-storage.mjs",
    "migration:test:synthetic": "node ../scripts/test-synthetic-migration.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.0"
  }
}
